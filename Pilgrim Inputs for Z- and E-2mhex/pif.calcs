#======================================#
# INPUT FILE TEMPLATES FOR: ORCA       #
#======================================#

#-------------------------#
# MEP POINT CALCULATIONS  #
#-------------------------#

#- - - - - - - - - - - - - -#
start_meppoint ts_a orca
%pal nprocs 1 end  
%maxcore 1000 
! hf sto-3g TightSCF        
[Pilgrim_gradientcalc_start]
! EnGrad
[Pilgrim_gradientcalc_end]
[Pilgrim_hessiancalc_start]
! Freq
[Pilgrim_hessiancalc_end]
* xyz 0 2
[Pilgrim_geometry]         
*

end_meppoint
